# ---- Cloudinary (this studio's own account) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret   # server-only — never put this in the website

# ---- Auth ----
SESSION_SECRET=paste_a_long_random_string_here

# ---- Studio owner login(s) ----
# "slug" MUST match SITE_SLUG in the .dc.html, or featured covers silently never appear.
# Use "password" to get started, then switch to "passwordHash" (npm run hash "pw").
CLIENTS_JSON=[{"slug":"studio","name":"[Studio Name]","folder":"studio","password":"change-me"}]

# ---- Client delivery galleries ----
# With ALLOW_OPEN_DELIVERIES=true any deliveries/<code> folder opens by its code.
# Per-gallery access codes are set in Studio Admin (they need the volume below).
GALLERIES_JSON=[]
ALLOW_OPEN_DELIVERIES=true
DELIVERIES_ROOT=deliveries

# ---- CORS: the real domain(s) once live; * only while testing ----
ALLOWED_ORIGINS=*

# ---- Persistent state (REQUIRES a Railway Volume mounted at /data) ----
# Password changes, gallery access codes and video links live here. Without a real
# mounted volume the app still runs, but those writes are refused rather than
# silently lost on the next deploy.
# CREDENTIALS_PATH=/data/credentials.json
# GALLERY_SETTINGS_PATH=/data/galleries.json
# VIDEOS_PATH=/data/videos.json
