---
/* Expanding card nav — ported from react-bits `CardNav` to vanilla Astro.
   The original drives height + card stagger with GSAP; here it's a CSS height
   transition on the house curve plus per-card transition-delay, with JS only
   measuring the open height. */
const menu = [
  {
    label: "The Stack",
    color: "n-blue",
    links: [
      { label: "What we build", href: "/#stak" },
      { label: "How it works", href: "/#start" },
      { label: "Recent work", href: "/#work" },
    ],
  },
  {
    label: "Pricing",
    color: "n-purple",
    links: [
      { label: "Plans", href: "/#pricing" },
      { label: "Add-ons", href: "/#pricing" },
      { label: "Build your stack", href: "/#build", cart: true },
    ],
  },
  {
    label: "Resources",
    color: "n-teal",
    links: [
      { label: "Blog", href: "/blog" },
      { label: "FAQ", href: "/#faq" },
      { label: "Free website audit", href: "/#audit" },
    ],
  },
];
---
<header class="nav" data-cardnav>
  <div class="wrap">
    <a class="logo" href="/#top" aria-label="SiteStac home"><img src="/logo.png" alt="SiteStac" class="logo-img" width="200" height="100" /></a>
    <nav class="nav-actions">
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel">
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
        <span class="nav-toggle-text">Menu</span>
      </button>
      <a class="btn" href="/#audit" data-magnetic>Get a free audit</a>
    </nav>
  </div>

  <div class="nav-panel" id="nav-panel">
    <div class="nav-cards">
      {menu.map((col, i) => (
        <div class={`nav-card ${col.color}`} style={`--i:${i}`}>
          <span class="nav-card-label">{col.label}</span>
          <div class="nav-card-links">
            {col.links.map((l) => (
              <a class={`nav-card-link${l.cart ? " cart-open" : ""}`} href={l.href}>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/></svg>
                {l.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-cardnav]");
  const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");
  const panel = header?.querySelector<HTMLElement>(".nav-panel");

  if (header && toggle && panel) {
    const isOpen = () => header.classList.contains("open");

    const setHeight = () => {
      // height:auto can't be transitioned, so measure the laid-out content.
      panel.style.height = `${panel.scrollHeight}px`;
    };

    const open = () => {
      header.classList.add("open");
      toggle.setAttribute("aria-expanded", "true");
      setHeight();
    };

    const close = () => {
      header.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
      panel.style.height = "";
    };

    toggle.addEventListener("click", () => (isOpen() ? close() : open()));

    // Any link inside the panel dismisses it — including .cart-open, whose own
    // handler on the home page opens the cart modal over the top.
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) { close(); toggle.focus(); }
    });

    document.addEventListener("click", (e) => {
      if (isOpen() && !header.contains(e.target as Node)) close();
    });

    window.addEventListener("resize", () => { if (isOpen()) setHeight(); });
  }
</script>
