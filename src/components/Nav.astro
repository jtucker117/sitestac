---
/* Bubble menu — ported from react-bits `BubbleMenu` to vanilla Astro.
   The original drives the pop-in with GSAP (back.out(1.5), 0.12s stagger and a
   small random jitter); here it's CSS transforms with matching cubic-beziers,
   the stagger as transition-delay, and the jitter baked per item.
   The overlay is a SIBLING of <header> on purpose: the header's backdrop-filter
   makes it a containing block, which would trap a position:fixed child. */
/* Each pill wears exactly the colour its matching BRICK wears, so the open menu
   reads as the same set of blocks as the page behind it. That means the base
   token everywhere except orange, which rests on --orange-d because white on
   base --orange is 2.53:1 — under the 3:1 floor for large bold text. (This is
   the same swap .brick.b-orange makes.) Resting on the dark variant across the
   board was the old rule; it made teal read olive and orange read brown.
   Hover DARKENS rather than brightens — brightening orange would have landed
   back on the 2.53:1 failure mid-interaction. */
const items = [
  { label: "the stack", href: "/#stak",    bg: "--blue",     hover: "--blue-d",   rot: -8, jit: -30 },
  { label: "build",     href: "/#build",   bg: "--teal",     hover: "--teal-d",   rot: 8,  jit: 20, cart: true },
  { label: "pricing",   href: "/#pricing", bg: "--orange-d", hover: "#a35400",    rot: 8,  jit: -10 },
  { label: "blog",      href: "/blog",     bg: "--pink",     hover: "--pink-d",   rot: 8,  jit: 35 },
  { label: "faq",       href: "/#faq",     bg: "--purple",   hover: "--purple-d", rot: -8, jit: -25 },
];
const paint = (c: string) => (c.startsWith("--") ? `var(${c})` : c);
---
<header class="nav" data-bubblenav>
  <div class="wrap">
    <a class="logo" href="/#top" aria-label="SiteStac home"><img src="/logo.png" alt="SiteStac" class="logo-img" width="200" height="100" /></a>
    <nav class="nav-actions">
      <a class="btn" href="/#audit" data-magnetic>Get a free audit</a>
      <button type="button" class="bubble-toggle" aria-expanded="false" aria-controls="bubble-menu" aria-label="Toggle navigation">
        <span class="menu-line" aria-hidden="true"></span>
        <span class="menu-line" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
</header>

<div class="bubble-menu" id="bubble-menu" aria-hidden="true">
  <ul class="pill-list">
    {items.map((it, i) => (
      <li class="pill-col">
        <a
          class={`pill-link${it.cart ? " cart-open" : ""}`}
          href={it.href}
          style={`--i:${i};--jit:${it.jit}ms;--rot:${it.rot}deg;--pill-bg:${paint(it.bg)};--pill-hover:${paint(it.hover)}`}
        >
          <span class="pill-label">{it.label}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".bubble-toggle");
  const menu = document.querySelector<HTMLElement>(".bubble-menu");

  if (toggle && menu) {
    const isOpen = () => document.body.classList.contains("bubble-open");

    const open = () => {
      document.body.classList.add("bubble-open");
      toggle.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-hidden", "false");
    };

    const close = () => {
      document.body.classList.remove("bubble-open");
      toggle.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
    };

    toggle.addEventListener("click", () => (isOpen() ? close() : open()));

    // A pill dismisses the menu; .cart-open's own handler on the home page
    // opens the cart modal over the top. Clicking the backdrop just closes.
    menu.addEventListener("click", (e) => {
      if (e.target === menu || (e.target as HTMLElement).closest("a")) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) { close(); toggle.focus(); }
    });
  }
</script>
